<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!-- Left sidebar: new-config button + scrollable profile list. -->
  <requires lib="gtk" version="4.18"/>

  <object class="GtkBox" id="list_root">
    <property name="width-request">300</property>
    <property name="orientation">vertical</property>
    <property name="spacing">6</property>

    <child>
      <object class="GtkButton" id="btn_new">
        <property name="label">新建配置</property>
        <property name="halign">center</property>
        <style>
          <class name="pill"/>
          <class name="suggested-action"/>
        </style>
      </object>
    </child>

    <child>
      <object class="GtkScrolledWindow" id="list_scroll">
        <property name="vexpand">True</property>
        <property name="hscrollbar-policy">never</property>
        <property name="child">
          <object class="GtkListBox" id="cfg_list">
            <property name="selection-mode">single</property>
            <style>
              <class name="navigation-sidebar"/>
            </style>
          </object>
        </property>
      </object>
    </child>

    <child>
      <object class="GtkLabel" id="list_hint">
        <property name="label">点击“新建配置”创建您的第一个配置</property>
        <property name="wrap">True</property>
        <property name="justify">center</property>
        <property name="visible">False</property>
        <style>
          <class name="dim-label"/>
        </style>
      </object>
    </child>
  </object>
</interface>
