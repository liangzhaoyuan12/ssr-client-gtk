<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <!-- Main window shell (GOAL 4.1): window → toast overlay → toolbar view
       → overlay split view (sidebar = config list, content = stack).
       Header bar and status bar are attached in code because AdwToolbarView
       top/bottom bars have no stable GtkBuilder child syntax. -->
  <requires lib="gtk" version="4.18"/>
  <requires lib="libadwaita" version="1.7"/>

  <object class="AdwApplicationWindow" id="window">
    <property name="default-width">800</property>
    <property name="default-height">600</property>
    <property name="content">
      <object class="AdwToastOverlay" id="toast_overlay">
        <property name="child">
          <object class="AdwToolbarView" id="toolbar">
            <property name="content">
              <object class="AdwOverlaySplitView" id="split">
                <property name="sidebar-width-fraction">0.35</property>
                <property name="show-sidebar">True</property>
                <property name="sidebar">
                  <object class="AdwNavigationPage" id="sidebar_page">
                    <property name="title">配置列表</property>
                    <property name="child">
                      <object class="GtkBox" id="sidebar_holder">
                        <property name="orientation">vertical</property>
                        <property name="spacing">6</property>
                        <property name="margin-start">6</property>
                        <property name="margin-end">6</property>
                        <property name="margin-top">6</property>
                        <property name="margin-bottom">6</property>
                      </object>
                    </property>
                  </object>
                </property>
                <property name="content">
                  <object class="AdwNavigationPage" id="content_page">
                    <property name="child">
                      <object class="GtkStack" id="stack">
                        <property name="transition-type">crossfade</property>
                        <child>
                          <object class="GtkStackPage">
                            <property name="name">empty</property>
                            <property name="child">
                              <object class="AdwStatusPage" id="empty_page">
                                <property name="title">暂无配置</property>
                                <property name="description">点击“新建配置”创建您的第一个配置</property>
                              </object>
                            </property>
                          </object>
                        </child>
                      </object>
                    </property>
                  </object>
                </property>
              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
