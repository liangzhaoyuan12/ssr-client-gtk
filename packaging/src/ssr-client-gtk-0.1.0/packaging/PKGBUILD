# Maintainer: liangzhaoyuan12 <liangzhaoyuan12@users.noreply.cnb.cool>
pkgname=ssr-client-gtk
pkgver=0.1.0
pkgrel=1
pkgdesc="GTK4/libadwaita ShadowsocksR client with a single routed SOCKS5 port"
arch=('x86_64')
url="https://cnb.cool/liangzhaoyuan12/ssr-client-rs"
license=('GPL3')
depends=('gtk4>=4.18' 'libadwaita>=1.7')
makedepends=('cargo')
# Local tarball produced by packaging/tarball.sh (Fedora build host; the
# .pkg.tar.zst produced here is the Arch artifact — runtime deps are
# provided by the gtk4/libadwaita RPMs already installed on this machine).
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  cargo build --frozen --release
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/ssr-client-gtk \
    "$pkgdir/usr/bin/ssr-client-gtk"
  install -Dm644 data/com.liangzhaoyuan12.ssr-client-gtk.desktop \
    "$pkgdir/usr/share/applications/com.liangzhaoyuan12.ssr-client-gtk.desktop"
  install -Dm644 data/com.liangzhaoyuan12.ssr-client-gtk.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.liangzhaoyuan12.ssr-client-gtk.metainfo.xml"
  for s in 48 64 128 256; do
    install -Dm644 "data/icons/hicolor/${s}x${s}/apps/com.liangzhaoyuan12.ssr-client-gtk.png" \
      "$pkgdir/usr/share/icons/hicolor/${s}x${s}/apps/com.liangzhaoyuan12.ssr-client-gtk.png"
  done
  install -Dm644 data/icons/hicolor/scalable/apps/com.liangzhaoyuan12.ssr-client-gtk.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.liangzhaoyuan12.ssr-client-gtk.svg"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
  install -Dm644 CHANGELOG.md "$pkgdir/usr/share/doc/$pkgname/CHANGELOG.md"
}
